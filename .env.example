# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do arquivo .env.local (ele já está no .gitignore).

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Anthropic (assistente de IA) -> https://console.anthropic.com/settings/keys
# Chave secreta: fica só no servidor, nunca vai para o navegador.
ANTHROPIC_API_KEY=sk-ant-...
